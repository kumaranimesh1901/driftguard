APP_ENV=dev
# start.sh replaces this with a random key when it creates .env
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
POSTGRES_URL=postgresql+psycopg2://driftguard:driftguard@localhost:5432/driftguard
MONGO_URL=mongodb://localhost:27017
MONGO_DB=driftguard
ARTIFACT_DIR=./artifacts
RANDOM_SEED=42
MAX_UPLOAD_MB=50
MAX_BATCH_ROWS=50000
PSI_BINS=10
NULL_BOOTSTRAP_B=200
NULL_QUANTILE=0.95
NORM_CAP_PSI=0.5
NORM_CAP_KS=0.5
NORM_CAP_JSD=0.3
D_AGGREGATION=max
SEVERITY_MODERATE=0.15
SEVERITY_HIGH=0.50
BATCH_DIS_MODERATE=0.05
BATCH_DIS_HIGH=0.25
PERF_MEANINGFUL_DROP=0.02
PERF_SEVERE_DROP=0.05
PERF_BOOTSTRAP_B=200
SENSITIVITY_REPEATS=5
SHAP_SAMPLE_SIZE=2000
MIN_LABELS=200
CONVENTIONAL_PSI=0.25
CONVENTIONAL_KS_P=0.01
CONVENTIONAL_JSD=0.1
